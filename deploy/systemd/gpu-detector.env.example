# Copy to /etc/gpu-detector.env, set mode 0600, and replace the token.
DETECTOR_GRPC_HOST=0.0.0.0
DETECTOR_GRPC_PORT=50051
DETECTOR_HEALTH_HOST=127.0.0.1
DETECTOR_HEALTH_PORT=8081

DETECTOR_DEVICE=0
DETECTOR_WEIGHTS=/opt/gpu-grpc-service/models/yolov5s.pt
DETECTOR_WEIGHTS_SHA256=8b3b748c1e592ddd8868022e8732fde20025197328490623cc16c6f24d0782ee
DETECTOR_DATA=/opt/gpu-grpc-service/config/coco80.yaml
DETECTOR_IMAGE_SIZE=640
DETECTOR_CONF_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.45
DETECTOR_MAX_DETECTIONS=300
DETECTOR_FP16=true

DETECTOR_BATCH_SIZE=1
DETECTOR_BATCH_WAIT_MS=0
DETECTOR_QUEUE_CAPACITY=8
DETECTOR_MAX_QUEUE_WAIT_MS=250
DETECTOR_MAX_FRAME_AGE_MS=1000
DETECTOR_MAX_FRAME_BYTES=4194304
DETECTOR_MAX_DIMENSION=16384
DETECTOR_GRPC_MAX_MESSAGE_BYTES=8388608
DETECTOR_GRPC_WORKERS=16

DETECTOR_AUTH_TOKEN=replace-with-a-long-random-secret
DETECTOR_LOG_LEVEL=INFO
